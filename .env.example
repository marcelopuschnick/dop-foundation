# =============================================================================
# DOP FOUNDATION — Variáveis de Ambiente (COPIAR PARA .env)
# =============================================================================

# ========================================
# AMBIENTE DE EXECUÇÃO
# ========================================
AMBIENTE=desenvolvimento  # desenvolvimento | producao
DEBUG=True                # True|False - Mostrar logs detalhados

# ========================================
# BLOCKCHAIN — Ganache Local (Testes)
# ========================================
REDE=polygon-amoy         # polygon-amoy | hardhat-local | sepolia
RPC_URL=http://127.0.0.1:8545       # URL do node local
CHAIN_ID=80002           # Chain ID da rede

# ========================================
# IPFS — Kubo Local (Armazenamento)
# ========================================
IPFS_API=http://127.0.0.1:5001        # Endpoint do IPFS Kubo

# ========================================
# BANCO DE DADOS — SQLite
# ========================================
DATABASE_URL=sqlite:///dados/dop.db    # Caminho para banco local

# ========================================
# CLAUDE API (Opcional — Para Agente Local)
# Desativado por segurança, usar Ollama local
# ========================================
ANTHROPIC_API_KEY=""          # COLOCAR SENHA SE USAR API EXTERNA
OLLAMA_URL=http://127.0.0.1:11434    # Modelo local qwen3.5:9b

# ========================================
# BLOCKBRAINES (Opcional — Análise Automática)
# ========================================
BLOCKBRAINES_API_KEY=""       # Deixe vazio se não usar


# =============================================================================
# ⚠️ SEGURANÇA
# =============================================================================
# NÃO subir este arquivo (.env) no repositório!
# Simbolos # começam comentários
# COPIAR para .env e preencher valores antes de rodar
